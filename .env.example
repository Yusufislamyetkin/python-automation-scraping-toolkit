# Copy to .env. Every integration is optional: missing credentials => demo mode
# (writes CSV under data/demo and logs "would send").

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Host port 5434 (compose maps postgres:5432 -> localhost:5434)
DATABASE_URL=postgresql+asyncpg://toolkit:toolkit@localhost:5434/toolkit
REDIS_URL=redis://localhost:6379/0

# Header X-API-Key required on POST /leads and POST /jobs/scrape
API_KEY=change-me

# Scraping politeness
USER_AGENT=PriceMonitorBot/0.1 (+https://github.com/Yusufislamyetkin/python-automation-scraping-toolkit)
REQUEST_DELAY_SECONDS=1.0
MAX_CONCURRENCY=4
MAX_PAGES=5
RESPECT_ROBOTS_TXT=true
# PROXY_URL=http://user:pass@proxy.example.com:8000

# Scheduler (worker container)
SCHEDULE_HOUR_UTC=6
SCHEDULE_TARGETS=["books"]

PRICE_CHANGE_THRESHOLD_PCT=0
LEAD_SCORE_THRESHOLD=60

# Google Sheets (service account JSON path; share the sheet with its email)
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# GOOGLE_SHEET_ID=

# HubSpot private app token (scope: crm.objects.contacts.write)
# HUBSPOT_TOKEN=

# Alerts: Slack and/or Telegram, email as fallback
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# n8n Gmail node sends qualified-lead alerts here
# SALES_EMAIL=sales@your-company.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ALERT_EMAIL_TO=
