{
  "id": "pmDailyPriceMon1",
  "name": "Daily competitor price monitor",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [],
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "nodes": [
    {
      "id": "a0000000-0000-4000-8000-000000000001",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -340
      ],
      "parameters": {
        "content": "## Daily competitor price monitor\n1. Every day 07:00 the toolkit scrapes the competitor catalogue (`wait=true` returns the change events).\n2. Each change becomes a row in the **changes** tab of your Google Sheet.\n3. One Slack message summarises all price drops / rises / stock changes.\n\nEnv (set in docker-compose): `TOOLKIT_API_URL`, `TOOLKIT_API_KEY`, `GOOGLE_SHEET_ID`, `SLACK_WEBHOOK_URL`. Pick your Google Sheets credential on the Sheet node.",
        "width": 520,
        "height": 280
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000002",
      "name": "Every day 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000003",
      "name": "Toolkit: run scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TOOLKIT_API_URL }}/jobs/scrape",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "books"
            },
            {
              "name": "wait",
              "value": "true"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.TOOLKIT_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000004",
      "name": "One item per change",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "changes",
        "options": {}
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000005",
      "name": "Append to Sheet (changes)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        -100
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "changes"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "detected_at": "={{ $json.created_at }}",
            "type": "={{ $json.type }}",
            "source": "={{ $json.source }}",
            "title": "={{ $json.product_title }}",
            "old": "={{ $json.old_value }}",
            "new": "={{ $json.new_value }}",
            "pct_change": "={{ $json.pct_change }}",
            "url": "={{ $json.product_url }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000006",
      "name": "Build Slack summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        100
      ],
      "parameters": {
        "jsCode": "const icons = { price_drop: '📉', price_rise: '📈', back_in_stock: '✅', out_of_stock: '⛔' };\nconst all = $input.all();\nconst lines = all.slice(0, 20).map(({ json: c }) =>\n  `${icons[c.type] ?? '•'} ${c.type.replace(/_/g, ' ')}: ${c.product_title} ${c.old_value ?? ''} → ${c.new_value ?? ''}` +\n  (c.pct_change ? ` (${c.pct_change}%)` : '') + ` <${c.product_url}|open>`);\nconst more = all.length > 20 ? `\\n…and ${all.length - 20} more` : '';\nreturn [{ json: { text: `*Competitor changes today (${all.length})*\\n${lines.join('\\n')}${more}` } }];"
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000007",
      "name": "Slack webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every day 07:00": {
      "main": [
        [
          {
            "node": "Toolkit: run scrape",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Toolkit: run scrape": {
      "main": [
        [
          {
            "node": "One item per change",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per change": {
      "main": [
        [
          {
            "node": "Append to Sheet (changes)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Build Slack summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Slack summary": {
      "main": [
        [
          {
            "node": "Slack webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
